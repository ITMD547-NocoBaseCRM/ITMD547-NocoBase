APP_ENV=production
APP_KEY=replace-with-a-long-random-secret
APP_PORT=13000

API_BASE_PATH=/api/
API_BASE_URL=
PLUGIN_PACKAGE_PREFIX=

DB_LOGGING=off
DB_DIALECT=postgres
DB_HOST=your-nocobase-postgres-host
DB_PORT=5432
DB_DATABASE=nocobase
DB_USER=your-user
DB_PASSWORD=your-password
DB_DIALECT_OPTIONS_SSL_REJECT_UNAUTHORIZED=false

INIT_ROOT_EMAIL=admin@example.com
INIT_ROOT_PASSWORD=change-this-password
INIT_ROOT_NICKNAME=Super Admin
INIT_ROOT_USERNAME=nocobase

# Customer messaging (Send message on the Customers page). See docs/customer-messaging.md.
# Email goes through the NocoBase Email notification channel (Settings -> Notification management).
# NOCOBASE_EMAIL_CHANNEL=              # optional: channel name or title when several exist
# SMS via Twilio (recommended): all three, then run `yarn apply:customer-messaging`.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1XXXXXXXXXX
# SMS via another gateway instead: JSON POST { to, body, customerId, messageId }.
# NOCOBASE_SMS_WEBHOOK_URL=
# NOCOBASE_SMS_AUTH_HEADER=

# Staff sign-in with Clerk (@salon/plugin-auth-clerk). See packages/plugins/@salon/plugin-auth-clerk/README.md.
# NocoBase has no build-time client env vars for plugins: every CLERK_* value below is read by the SERVER.
# Only CLERK_PUBLISHABLE_KEY is ever sent to the browser (via authenticators:publicList); it is public by design.
# Use pk_test_/sk_test_ keys from the Clerk Development instance locally and pk_live_/sk_live_ in production.
# SERVER -> browser (public): Clerk Dashboard -> Configure -> API keys -> Publishable key
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# SERVER ONLY (secret): Clerk Dashboard -> Configure -> API keys -> Secret key. Never commit or share it.
CLERK_SECRET_KEY=sk_test_replace_me
# SERVER ONLY (required): comma-separated origins (scheme://host[:port], no path) the CRM is served from.
# Must match the azp claim of Clerk session tokens, e.g. http://localhost:13000,https://crm.example.com
CLERK_AUTHORIZED_PARTIES=http://localhost:13000
# SERVER ONLY (optional): PEM public key for networkless token verification (API keys -> JWT public key -> PEM).
# Put it on one line with 
 line breaks. Without it, the signing keys are fetched from Clerk with the secret key.
# CLERK_JWT_KEY=
# SERVER ONLY (optional): expected issuer. Defaults to https://<Frontend API host> derived from the publishable key.
# CLERK_ISSUER=
# SERVER ONLY (optional): require this aud claim (only if you add "aud" to the session token in the Clerk Dashboard).
# CLERK_AUDIENCE=
# SERVER ONLY (optional): NocoBase roles that count as staff. Default: admin,r_staff,r_receptionist. "root" is never allowed.
# CLERK_ALLOWED_ROLES=admin,r_staff,r_receptionist
# SERVER ONLY (optional): seconds between Clerk session-status rechecks for an issued NocoBase session (min 30). Default 300.
# CLERK_SESSION_RECHECK_SECONDS=300
# SERVER ONLY (optional): where Clerk invitation emails send new staff. Must be on a CLERK_AUTHORIZED_PARTIES origin.
# Default: <first authorized origin>/staff-invite (legacy client). Use .../v/staff-invite for the modern client.
# CLERK_INVITE_REDIRECT_URL=http://localhost:13000/staff-invite
# SERVER ONLY (optional): days an invitation link stays valid (1-30). Default 7.
# CLERK_INVITATION_EXPIRES_DAYS=7
