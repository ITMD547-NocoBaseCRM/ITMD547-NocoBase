{
  "name": "nocobase-app",
  "private": true,
  "workspaces": [
    "packages/*/*",
    "packages/*/*/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "nocobase": "nocobase-v1",
    "pm": "nocobase-v1 pm",
    "pm2": "nocobase-v1 pm2",
    "dev": "nocobase-v1 app-dev",
    "start": "nocobase-v1 start",
    "clean": "nocobase-v1 clean",
    "build": "nocobase-v1 build",
    "test": "nocobase-v1 test",
    "e2e": "nocobase-v1 e2e",
    "tar": "nocobase-v1 tar",
    "postinstall": "nocobase-v1 postinstall",
    "lint": "eslint .",
    "migrate:appointments-collection": "node scripts/run-appointments-collection-migration.js",
    "validate:appointments-collection": "node scripts/validate-appointments-collection.js",
    "test:appointments-collection": "node --test scripts/appointments-schema.test.js",
    "migrate:appointments-migration-prep": "node scripts/run-appointments-migration-prep.js",
    "validate:appointments-migration-prep": "node scripts/validate-appointments-migration-prep.js",
    "test:appointments-import": "node --test scripts/appointments-import.test.js",
    "migrate:appointments-ui-labels": "node scripts/run-appointments-ui-labels-migration.js",
    "migrate:appointment-services-cascade": "node scripts/run-appointment-services-cascade-migration.js",
    "apply:appointments-ui": "node scripts/apply-appointments-ui.js",
    "validate:appointments-ui": "node scripts/validate-appointments-ui.js",
    "test:appointments-ui": "node --test scripts/appointments-page-blueprint.test.js scripts/appointments-page-layout.test.js"
  },
  "resolutions": {
    "cytoscape": "3.28.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "^18.0.0",
    "react-router-dom": "^6.30.1",
    "react-router": "^6.30.1",
    "antd": "5.24.2",
    "async": "^3.2.6",
    "rollup": "4.24.0",
    "semver": "^7.7.1"
  },
  "dependencies": {
    "pm2": "^6.0.5",
    "mysql2": "^3.14.0",
    "mariadb": "^2.5.6",
    "pg": "^8.14.1",
    "pg-hstore": "^2.3.4",
    "@nocobase/app": "2.2.12"
  },
  "devDependencies": {
    "@nocobase/devtools": "2.2.12"
  }
}
